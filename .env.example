# Copiar a .env para desarrollo local (node --env-file=.env server.js).
# En Render, estas mismas variables van en el tab Environment del servicio —
# nunca en un archivo commiteado.

# Proyecto Supabase de ESTE despliegue (uno dedicado a este cliente — ver README).
# Settings -> API en el dashboard de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key, NO la anon/public key. El backend la usa para saltarse
# RLS; nunca se envía al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier cadena larga y aleatoria, distinta por despliegue. Firma la
# cookie de sesión del panel del dueño.
SESSION_SECRET=

# Puerto local (Render lo asigna solo vía PORT, no hace falta tocarlo ahí).
PORT=3000

# 'production' en Render (activa cookies secure). Vacío/'development' en local.
NODE_ENV=development
